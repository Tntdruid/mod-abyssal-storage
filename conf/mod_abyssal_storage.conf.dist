[worldserver]

###################################################################################################
#    MOD ABYSSAL STORAGE
###################################################################################################

#
#    AbyssalStorage.Enable
#        Description: Enable the Abyssal Storage module.
#        Default:     1 (Enabled)
#                     0 (Disabled)
#

AbyssalStorage.Enable = 1

#
#    AbyssalStorage.EnableSharing
#        Description: Let players share one vault between accounts without a GM, using
#                     .abs share invite/accept/decline/leave/kick. GMs can always link
#                     accounts with .abs link, whatever this is set to.
#        Default:     1 (Enabled)
#                     0 (Disabled)
#

AbyssalStorage.EnableSharing = 1

#
#    AbyssalStorage.ExtraItems
#        Description: Item ids to store on top of trade goods and gems, separated by
#                     commas or spaces. Use this for gathered items the game files as
#                     quest or misc items. While an active quest needs one of these
#                     items, the quest's amount stays in your bags.
#        Example:     "4278, 12345"
#        Default:     "4278" (Lesser Bloodstone Ore)
#

AbyssalStorage.ExtraItems = "4278"
