[worldserver]

###################################################################################################
#    MOD POCKET STORAGE
###################################################################################################

#
#    PocketStorage.Enable
#        Description: Enable the Pocket Storage module.
#        Default:     1 (Enabled)
#                     0 (Disabled)
#

PocketStorage.Enable = 1

#
#    PocketStorage.EnableSharing
#        Description: Let players share one vault between accounts without a GM, using
#                     .ps share invite/accept/decline/leave/kick. GMs can always link
#                     accounts with .ps link, whatever this is set to.
#        Default:     1 (Enabled)
#                     0 (Disabled)
#

PocketStorage.EnableSharing = 1

#
#    PocketStorage.DepositMessage
#        Description: Print a chat line such as "Stored [Linen Cloth] x2 (92 in storage)."
#                     each time looted items are stored automatically.
#        Default:     1 (Enabled)
#                     0 (Disabled)
#

PocketStorage.DepositMessage = 1

#
#    PocketStorage.ExtraItems
#        Description: Item ids to store on top of trade goods and gems, separated by
#                     commas or spaces. Use this for gathered items the game files as
#                     quest or misc items. While an active quest needs one of these
#                     items, the quest's amount stays in your bags.
#        Example:     "4278, 12345"
#        Default:     "4278" (Lesser Bloodstone Ore)
#

PocketStorage.ExtraItems = "4278"

#
#    PocketStorage.RandomBotAccountPrefix
#        Description: Accounts whose username starts with this prefix (any case) are random
#                     playerbots and are ignored by the vault. Leave empty to use
#                     mod-playerbots' own Playerbots.RandomBotAccountPrefix, or "rndbot"
#                     when that is not set.
#        Example:     "botr2"
#        Default:     "" (follow mod-playerbots)
#

PocketStorage.RandomBotAccountPrefix = ""
